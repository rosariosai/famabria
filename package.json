{
  "name": "famabria",
  "version": "2.10.0",
  "license": "MIT",
  "author": "Rosario Savoia",
  "type": "module",
  "description": "Family calendar with shared, end-to-end encrypted notes and reminders. Browser extension (Chrome, Firefox), installable web app (PWA) and a small self-hostable relay.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosariosai/famabria.git"
  },
  "homepage": "https://famabria.com",
  "bugs": {
    "url": "https://github.com/rosariosai/famabria/issues"
  },
  "scripts": {
    "dev": "vite build --watch --mode chrome",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build:web": "vite build --mode web",
    "build": "npm run build:chrome && npm run build:firefox && npm run build:web",
    "build:server": "node server/build.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:assets": "node scripts/android-assets.mjs",
    "build:relay": "node relay/build.mjs",
    "deploy:relay": "npm run build:web && node relay/site.mjs && npm run build:relay && npx wrangler deploy -c relay/wrangler.toml",
    "dev:relay": "npm run build:relay && npx wrangler dev -c relay/wrangler.toml",
    "publish:relay": "npx wrangler deploy -c relay/wrangler.toml"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "mysql2": "^3.24.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
